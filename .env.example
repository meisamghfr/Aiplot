TEXT2SQL_API_URL=http://127.0.0.1:8000
AIPLOT_MAX_PLOT_ROWS=300
AIPLOT_TEXT2SQL_TIMEOUT_SECONDS=180
AIPLOT_DBT_PROJECT_DIR=dbt_analytics
AIPLOT_DBT_PROFILES_DIR=dbt_analytics
AIPLOT_DBT_SOURCE_SCHEMA=raw
AIPLOT_STATE_DIR=.aiplot
AIPLOT_POWERBI_ARTIFACT_DIR=powerbi_artifacts
AIPLOT_WAREHOUSE_HOST=127.0.0.1
AIPLOT_WAREHOUSE_PORT=5432
AIPLOT_WAREHOUSE_DB=aiplot_warehouse
AIPLOT_WAREHOUSE_USER=
AIPLOT_WAREHOUSE_PASSWORD=
# Configure the separate Text-to-SQL service with:
# TEXT2SQL_POSTGRES_DATABASES={"warehouse":"postgresql://localhost/aiplot_warehouse"}
# Optional live Power BI service publishing. When incomplete, Aiplot writes a safe manifest.
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
POWERBI_WORKSPACE_ID=
POWERBI_PBIX_TEMPLATE_PATH=
